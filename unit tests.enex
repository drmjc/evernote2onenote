    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div style="display:none;--en-chs:&quot;&quot;"> </div><div><br/></div><div style="position: relative"><div style="font-size: 16px"><div style="overflow-y:scroll;"><div style="color:rgb(51, 51, 51);font-family:Arial, Helvetica, sans-serif;font-size:14px;font-weight:normal;text-decoration:initial;background-image:url(http://www.hire-it.com.au/images/frontend/bg_body.jpg);background-color:rgb(229, 228, 226);background-position:0px 2px;background-repeat:repeat no-repeat;"><div style="background-image:url(http://www.hire-it.com.au/images/frontend/bottom_body_bg.jpg);background-position:50% 100%;background-repeat:repeat no-repeat;"><div style="background-image:url(http://www.hire-it.com.au/images/frontend/content_bg.jpg);background-position:50% 374px;background-repeat:no-repeat repeat;"><div style="background-image:url(http://www.hire-it.com.au/images/frontend/content_bottom_bg.jpg);background-position:50% 100%;background-repeat:no-repeat no-repeat;"><div style="background-image:url(http://www.hire-it.com.au/images/frontend/body_bg.jpg);background-position:0px 0px;background-repeat:repeat no-repeat;"><div style="background-image:url(http://www.hire-it.com.au/images/frontend/subpage_banner_bg.jpg);background-position:50% 166px;background-repeat:no-repeat no-repeat;"><div style="overflow:hidden;"><div>
            	<div style="margin:0px;padding:0px;width:737px;float:left;height:150px;">
              	
				
				<div style="margin:0px;padding:28px 0px 0px 53px;width:186px;float:left;background-image:url(http://www.hire-it.com.au/images/frontend/top_add_seperator.gif);font-family:Helvetica, Arial, Helvetica, sans-serif;font-size:15px;color:rgb(255, 255, 255);background-position:100% 0%;background-repeat:no-repeat no-repeat;">
                	<p style="margin:0px;padding:0px;font-size:18px;text-transform:uppercase;letter-spacing:1.2px;line-height:20px;">Doncaster</p>
					<span style="display:block;">
                  </span><p style="margin:0px;padding:0px;line-height:20px;"><span>2 Rose Street</span></p>
                  <p style="margin:0px;padding:0px;line-height:20px;"><span>Melbourne</span>, <span>Victoria</span> </p>
				  

    			<p style="margin:0px;padding:0px;font-family:helveticacondensedbold, Arial, Helvetica, sans-serif;font-size:20px;line-height:20px;"><span>03 8832 7000</span></p>
								
				</div>
				
				<div style="margin:0px;padding:28px 0px 0px 53px;width:186px;float:left;background-image:url(http://www.hire-it.com.au/images/frontend/top_add_seperator.gif);font-family:Helvetica, Arial, Helvetica, sans-serif;font-size:15px;color:rgb(255, 255, 255);background-position:100% 0%;background-repeat:no-repeat no-repeat;">
                	<p style="margin:0px;padding:0px;font-size:18px;text-transform:uppercase;letter-spacing:1.2px;line-height:20px;">BAYSWATER</p>
					<span style="display:block;">
                  </span><p style="margin:0px;padding:0px;line-height:20px;"><span>256 Canterbury Road,</span></p>
                  <p style="margin:0px;padding:0px;line-height:20px;"><span>Melbourne</span>, <span>Victoria</span> </p>
				  

    			<p style="margin:0px;padding:0px;font-family:helveticacondensedbold, Arial, Helvetica, sans-serif;font-size:20px;line-height:20px;"><span>03 9739 9000</span></p>
								
				</div>
				
               
                <div style="margin:32px 0px 0px 34px;padding:0px;width:219px;float:left;font-family:Helvetica, Arial, Helvetica, sans-serif;font-size:14px;color:rgb(194, 203, 210);line-height:17px;letter-spacing:0.4px;">
                	<div style="margin:0px 0px 8px 6px;padding:0px 0px 9px;width:212px;float:left;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:rgb(81, 106, 126);">
